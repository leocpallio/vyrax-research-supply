{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.tsx",
    "src/server.ts",
    "src/start.ts",
    "src/router.tsx",
    "src/**/*.test.{ts,tsx}",
    "tests/*.test.ts",
    "tests-admin.test.ts",
    "scripts/**/*.{mjs,ts}",
    "src/lib/email/v4/index-*.ts",
    "src/lib/email/v4/render-all-v4.ts",
    "src/lib/email/render-previews.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/*.ts",
    "tests-admin.test.ts",
    "scripts/**/*.{mjs,ts}"
  ],
  "ignore": ["src/components/ui/**", "src/routeTree.gen.ts"],
  "ignoreDependencies": ["@radix-ui/*", "@tanstack/router-plugin", "@lovable.dev/*", "tailwindcss", "tw-animate-css"]
}
